[Unit]
Description=Run the AAK restore test every Wednesday and Sunday

[Timer]
# Wednesday and Sunday 03:30 Sri Lanka time, an hour after the nightly backup, when nobody is using the system.
OnCalendar=Wed,Sun *-*-* 03:30:00 Asia/Colombo
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
